# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
API_GLOBAL_PREFIX=api
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgresql://zal:zal@localhost:5432/zal?schema=public
REDIS_URL=redis://localhost:6379

# Access token is short-lived and sent as a Bearer header.
# Refresh token is rotated on every use; web stores it in an httpOnly cookie,
# mobile stores it in the OS keychain via expo-secure-store.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=900              # seconds (15 min)
JWT_REFRESH_TTL=2592000         # seconds (30 days)

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# OTP delivery. Leave SMS_PROVIDER=console in development: codes are logged.
SMS_PROVIDER=console
SMS_SENDER_ID=Zal
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Google sign-in (optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for venue photos (MinIO in development, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zal-media
S3_ACCESS_KEY_ID=zal
S3_SECRET_ACCESS_KEY=zalzalzal
S3_FORCE_PATH_STYLE=true

# Payments. Providers used in Armenia: ArCa/Visa/Mastercard via an acquirer,
# Idram and Telcell wallets, plus manual bank transfer.
PAYMENTS_PROVIDER=mock
ARCA_MERCHANT_ID=
ARCA_MERCHANT_SECRET=
IDRAM_MERCHANT_ID=
IDRAM_SECRET_KEY=
TELCELL_SHOP_ID=
TELCELL_SHOP_KEY=

# Push notifications (Expo push service)
EXPO_ACCESS_TOKEN=

# Scheduled jobs: completing past bookings, balance reminders, releasing unpaid
# holds, pruning refresh tokens. Exactly ONE process in a deployment should run
# them — two instances with this on would send every reminder twice.
ENABLE_SCHEDULER=true
# How long a booking may hold a date before the deposit arrives.
BOOKING_HOLD_MINUTES=60

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── Mobile (apps/mobile) ────────────────────────────────────────────────────
# Use your machine's LAN IP when running on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_WS_URL=ws://localhost:4000
