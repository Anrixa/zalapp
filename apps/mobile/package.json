{
  "name": "@zal/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Zal for iOS and Android — Expo Router, React Native.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --ext .ts,.tsx --max-warnings 0",
    "test": "echo \"no tests\" && exit 0",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.2.3",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "@tanstack/react-query": "^5.62.11",
    "@zal/api-client": "workspace:*",
    "@zal/contracts": "workspace:*",
    "@zal/i18n": "workspace:*",
    "@zal/tokens": "workspace:*",
    "expo": "~52.0.23",
    "expo-constants": "~17.0.4",
    "expo-device": "~7.0.2",
    "expo-font": "~13.0.2",
    "expo-linking": "~7.0.4",
    "expo-localization": "~16.0.1",
    "expo-notifications": "~0.29.12",
    "expo-router": "~4.0.16",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.19",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.2"
  }
}
