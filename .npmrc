# React Native's tooling assumes a flat node_modules.
#
# Metro resolves a transitive dependency by walking up from the file that
# imports it, and several packages in the Expo stack rely on dependencies they
# do not declare. Under pnpm's default isolated layout those simply are not
# reachable, and the symptom is a stream of "Unable to resolve module X" errors
# from files nobody in this repo wrote — query-string, @babel/runtime, and so on.
#
# Expo's own monorepo guidance is to use a hoisted linker, so that is what this
# workspace does. The trade-off is the usual one: a package can now import
# something it never declared and get away with it. Worth it to have a mobile
# build that works at all.
node-linker=hoisted

# Keep peer dependency resolution strict enough to catch real version clashes.
strict-peer-dependencies=false
auto-install-peers=true
