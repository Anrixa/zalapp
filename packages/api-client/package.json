{
  "name": "@zal/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP and realtime client for the Zal API, with React Query hooks shared by web and mobile.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@zal/contracts": "workspace:*",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.11",
    "@types/react": "^18.3.17",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "react": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
